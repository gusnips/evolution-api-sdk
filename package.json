{
  "name": "evolution-api-sdk",
  "packageManager": "bun@1.4.4",
  "private": false,
  "version": "0.7.0",
  "description": "Unofficial SDK for the Evolution Whatsapp API v2",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "module": "lib/index.mjs",
  "files": [
    "lib",
    "CHANGELOG.md"
  ],
  "scripts": {
    "release": "rm -rf lib && tsdown && npm publish",
    "check-types": "tsc --noEmit",
    "build": "tsdown",
    "lint": "eslint --fix"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "libphonenumber-js": "^1.12.7"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "tsdown": "0.23.7",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "evolution",
    "api",
    "whatsapp",
    "baileys",
    "zap",
    "node",
    "evolution-api",
    "evolution-api-sdk",
    "v2"
  ],
  "author": {
    "name": "Gustavo Salomé Silva",
    "url": "https://github.com/gusnips"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gusnips/evolution-api-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/gusnips/evolution-api-sdk/issues"
  },
  "homepage": "https://github.com/gusnips/evolution-api-sdk#readme",
